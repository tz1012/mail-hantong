{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mail.messages.search.schema.json",
  "title": "mail.messages.search local IMAP metadata request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "tool", "params"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._:-]+$"},
    "tool": {"const": "mail.messages.search"},
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "account_id", "wire_hex", "encoding"],
      "properties": {
        "mode": {"const": "imap_metadata"},
        "account_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$"},
        "wire_hex": {"type": "string", "minLength": 2, "maxLength": 2048, "pattern": "^(?:[0-9a-f]{2})+$"},
        "encoding": {"enum": ["modified_utf7", "utf8"]},
        "filter": {"enum": ["all", "unread", "favorite"], "default": "all"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 32, "default": 16},
        "cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
      }
    }
  }
}
