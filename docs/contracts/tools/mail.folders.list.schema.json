{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mail.folders.list.schema.json",
  "title": "mail.folders.list request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "tool",
    "params"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "tool": {
      "const": "mail.folders.list"
    },
    "params": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "account_id"
          ],
          "properties": {
            "account_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32,
              "default": 32
            },
            "cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2220
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "account_id"
          ],
          "properties": {
            "mode": {
              "const": "gmail_labels"
            },
            "account_id": {
              "type": "string",
              "pattern": "^google_[0-9a-f]{64}$"
            }
          }
        }
      ]
    }
  }
}
