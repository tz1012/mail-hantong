{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mail.accounts.list.schema.json",
  "title": "mail.accounts.list request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "tool", "params"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._:-]+$" },
    "tool": { "const": "mail.accounts.list" },
    "params": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["account_id"],
          "properties": {
            "account_id": { "$ref": "common.schema.json#/$defs/account_id" },
            "include_capabilities": { "type": "boolean", "default": false }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["account_ids"],
          "properties": {
            "account_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": { "$ref": "common.schema.json#/$defs/account_id" }
            },
            "include_capabilities": { "type": "boolean", "default": false }
          }
        }
      ]
    }
  }
}
