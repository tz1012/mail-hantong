{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mail.send.execute.schema.json",
  "title": "mail.send.execute request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "tool", "params"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._:-]+$" },
    "tool": { "const": "mail.send.execute" },
    "params": {
      "type": "object", "additionalProperties": false,
        "required": ["account_id", "draft_id", "operation_id", "expected_version", "payload_hash", "approval_id", "idempotency_key"],
      "properties": {
        "account_id": { "$ref": "common.schema.json#/$defs/account_id" },
        "draft_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
        "operation_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
        "expected_version": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
        "payload_hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "approval_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" }
      }
    }
  }
}
