{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "app.diagnostics.snapshot.schema.json",
  "title": "app.diagnostics.snapshot request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "tool",
    "params"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "tool": {
      "const": "app.diagnostics.snapshot"
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_utc_ms",
        "to_utc_ms",
        "sections"
      ],
      "properties": {
        "from_utc_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "to_utc_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "max_executions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "sync",
              "recent_work",
              "errors"
            ]
          }
        }
      }
    }
  }
}
