{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mail.drafts.create.schema.json",
  "type": "object",
  "additionalProperties": false,
  "title": "mail.drafts.create",
  "required": [
    "schema_version",
    "request_id",
    "tool",
    "params"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "tool": {
      "const": "mail.drafts.create"
    },
    "params": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "to",
        "subject",
        "body",
        "operation_id",
        "idempotency_key",
        "expected_version",
        "payload_hash"
      ],
      "properties": {
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "to": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 320
          }
        },
        "subject": {
          "type": "string",
          "maxLength": 998
        },
        "body": {
          "type": "string",
          "maxLength": 1048576
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "expected_version": {
          "const": 0
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
