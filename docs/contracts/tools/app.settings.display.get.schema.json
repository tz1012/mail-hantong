{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "app.settings.display.get.schema.json",
  "title": "app.settings.display.get request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "tool",
    "params"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "tool": {
      "const": "app.settings.display.get"
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  }
}
