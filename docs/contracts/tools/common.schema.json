{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "mail-hantong common tool envelope",
  "description": "client identity and authorization are supplied by the authenticated server session; client_id is intentionally not accepted in this untrusted envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "tool", "params"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._:-]+$" },
    "tool": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z][a-z0-9.]{0,95}$" },
    "params": { "type": "object", "additionalProperties": true }
  },
  "$defs": {
    "account_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
    "account_scope": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["account_id"], "properties": { "account_id": { "$ref": "common.schema.json#/$defs/account_id" } } },
        { "type": "object", "additionalProperties": false, "required": ["account_ids"], "properties": { "account_ids": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/account_id" } } } }
      ]
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "enum": ["INVALID_INPUT", "AUTH_REQUIRED", "SCOPE_DENIED", "POLICY_BLOCKED", "CONFLICT", "RATE_LIMITED", "OFFLINE", "NOT_FOUND", "SEND_UNKNOWN", "APPROVAL_REQUIRED", "APPROVAL_EXPIRED", "APPROVAL_DENIED", "APPROVAL_RATE_LIMITED", "CLIENT_NOT_REGISTERED", "CLIENT_SUSPENDED", "HUMAN_STEP_REQUIRED", "CORE_UNAVAILABLE", "VERSION_MISMATCH", "CURSOR_EXPIRED", "CAPABILITY_UNSUPPORTED", "QUOTA_EXCEEDED", "INTERNAL_ERROR"] },
        "message": { "type": "string", "maxLength": 512 },
        "retryable": { "type": "boolean" }
      }
    },
    "account_result": {
      "type": "object", "additionalProperties": false, "required": ["account_id", "status", "items"],
      "properties": {
        "account_id": { "$ref": "common.schema.json#/$defs/account_id" },
        "status": { "enum": ["complete", "partial", "unavailable"] },
        "items": { "type": "array", "maxItems": 1024 },
        "error": { "$ref": "common.schema.json#/$defs/error" }
      }
    },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "maxLength": 64 },
        "source": { "type": "string", "maxLength": 64 },
        "cached": { "type": "boolean" },
        "latency_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "untrusted_content": {
      "type": "array", "maxItems": 1024,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["content_type", "content", "byte_length", "truncated"],
        "properties": {
          "content_type": { "enum": ["text", "html", "header", "attachment_ref"] },
          "content": { "type": "string", "maxLength": 1048576 },
          "byte_length": { "type": "integer", "minimum": 0 },
          "truncated": { "type": "boolean" }
        }
      }
    },
    "response": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["schema_version", "ok", "items", "next_cursor", "account_results", "completeness", "warnings", "observed_at"],
          "properties": {
            "schema_version": { "type": "integer", "const": 1 }, "ok": { "const": true }, "items": { "type": "array", "maxItems": 1024 }, "next_cursor": { "type": ["string", "null"], "maxLength": 256 }, "account_results": { "type": "array", "maxItems": 1024, "items": { "$ref": "common.schema.json#/$defs/account_result" } }, "completeness": { "enum": ["complete", "partial", "unavailable"] }, "warnings": { "type": "array", "maxItems": 256, "items": { "type": "string", "maxLength": 512 } }, "observed_at": { "type": ["string", "null"], "format": "date-time" }, "metadata": { "$ref": "common.schema.json#/$defs/metadata" }, "untrusted_content": { "$ref": "common.schema.json#/$defs/untrusted_content" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["schema_version", "ok", "items", "next_cursor", "account_results", "completeness", "warnings", "observed_at", "error"],
          "properties": {
            "schema_version": { "type": "integer", "const": 1 }, "ok": { "const": false }, "items": { "const": [] }, "next_cursor": { "const": null }, "account_results": { "const": [] }, "completeness": { "const": "unavailable" }, "warnings": { "type": "array", "maxItems": 256, "items": { "type": "string", "maxLength": 512 } }, "observed_at": { "const": null }, "error": { "$ref": "common.schema.json#/$defs/error" }, "metadata": { "$ref": "common.schema.json#/$defs/metadata" }
          }
        }
      ]
    }
  }
}
