{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mail-hantong.local/contracts/config.schema.json",
  "title": "mail-hantong configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "settings_version", "cli", "gui", "locale"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "settings_version": { "type": "integer", "minimum": 1 },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language"],
      "properties": {
        "language": { "type": "string", "enum": ["en", "ko"], "default": "en" }
      }
    },
    "gui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme"],
      "properties": {
        "language": { "type": "string", "enum": ["en", "ko"] },
        "theme": { "type": "string", "enum": ["light", "dark", "system"], "default": "system" }
      }
    },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone_id"],
      "properties": {
        "timezone_id": { "type": "string", "minLength": 1, "maxLength": 128, "format": "iana-timezone" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "description": "Protected policy settings. They are never writable through generic CLI config commands.",
      "properties": {
        "external_ai_enabled": { "type": "boolean", "default": false }
      }
    }
  }
}
